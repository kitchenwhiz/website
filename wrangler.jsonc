{
  // Static website for commercialkitchens.co.in, served by Cloudflare Workers (static assets only, no server code).
  "name": "website",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  },
  "workers_dev": true,
  "routes": [
    { "pattern": "commercialkitchens.co.in", "custom_domain": true },
    { "pattern": "www.commercialkitchens.co.in", "custom_domain": true }
  ]
}
